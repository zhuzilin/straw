{
  "date": "2026-10-25",
  "scope": "Actual queue event validation/serialization-to-durable-frame composition, successful byte/Value replay observations and finite-history observation equivalence. Full Coordinator business fold, physical retained-prefix selection and native File/run identity remain open.",
  "runtime_changes": "Existing Journal::append validation and serialization are moved into journal_append and composed with the existing verified State::append_to. Appender construction before encoding only borrows fields; no new serialization/filesystem operation. Error precedence/classes and quarantine remain. No performance claim.",
  "theorems": {
    "journal_append::encode": "Rejects exactly structurally invalid event lists as Events; successful serialization binds exact input to payload under existing Value encoding law. Does not claim serializer acceptance.",
    "journal_append::append": "Success binds source events to a complete durable queue frame, preserves the preceding bytes and returns the prior sequence. Pre-write errors leave log/writer unchanged; write errors preserve confirmed boundaries and quarantine.",
    "journal_equivalence::recovered_frame_observations": "A successful read satisfying the actual frame decoder contract yields the exact accepted payload/end; successful Value parsing has original finite-depth observations.",
    "journal_equivalence::encoded_history_observations": "For arbitrary finite encoded original transactions and decoded transactions with identical raw sequence, finite-depth observations match at every position.",
    "journal_equivalence::repeated_recovery_observations": "Independent successful transaction reconstructions of the same raw sequence have the same finite-depth observations."
  },
  "trusted_premises": "Existing Writer/Device/SHA and Value encode/parse-observation library laws; no new trusted primitive or admitted straw body. Number observation is only as_u64, not full floating-point equality. Native surviving-prefix selection, complete coordinator and GC call chains, complete roots and caches, and cross-log composition and parser acceptance are not established.",
